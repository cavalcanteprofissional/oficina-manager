# ============================================
# OFICINA MANAGER - VARIÁVEIS DE AMBIENTE
# ============================================
# Copie este arquivo como .env.local e
# preencha com os valores do seu projeto Supabase
# ============================================

# URL do projeto Supabase (Dashboard > Settings > API > Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co

# Chave anônima/publishable do Supabase (Dashboard > Settings > API > Anon Key)
# Essa chave é pública e pode ser exposta no frontend
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_chave_anon_aqui
